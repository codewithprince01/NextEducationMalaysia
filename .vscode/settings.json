{
  "postman.settings.dotenv-detection-notification-visibility": false,

  // Use the TypeScript installed in this repo instead of the one bundled with
  // the editor. Without this the editor reports config errors (for example
  // "Invalid value for '--ignoreDeprecations'") that no build ever produces.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true
}
